# MEMORA Backend Environment Configuration
# Copy this file to .env and adjust values for local development or set them in Render / Vercel dashboard.

# Application
APP_NAME=MEMORA
FRONTEND_URL=https://your-memora-app.vercel.app

# Database (PostgreSQL on Supabase / Neon / Render)
# For Supabase: Transaction pooler or Session pooler URI
# Example: postgresql://postgres.xxxx:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# JWT Authentication
JWT_SECRET=replace-with-a-secure-random-secret-key-for-jwt-tokens-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cloud Storage: Supabase Storage Bucket
# Set these to enable permanent document file storage on Supabase Cloud
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_BUCKET=memora-documents
